{
	"name": "@o7/favicon",
	"version": "0.0.8",
	"description": "Automatically generate favicons for your Svelte app",
	"keywords": [
		"favicon",
		"favicons",
		"svelte",
		"svg",
		"vite-plugin",
		"webmanifest"
	],
	"license": "MIT",
	"repository": {
		"url": "git+https://github.com/ottomated/o7-favicon.git"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/modules.d.ts"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"types": "./dist/index.d.ts",
	"svelte": "./dist/index.js",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"import": "./dist/vite.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && pnpm prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"fmt": "oxfmt ."
	},
	"dependencies": {
		"@types/web-app-manifest": "^1.0.9",
		"ico-endec": "^0.1.6",
		"sharp": "^0.35.5",
		"svgo": "^4.1.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/package": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.5",
		"eslint": "^10.13.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"oxfmt": "^0.74.0",
		"publint": "^0.3.25",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"packageManager": "pnpm@12.15.0"
}
